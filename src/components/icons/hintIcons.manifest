# Regenerate from the repository root with:
#   python3 freeink-sdk/libs/assets/Icons/tools/gen_icons.py \
#     --manifest src/components/icons/hintIcons.manifest \
#     --svgdir freeink-sdk/libs/assets/Icons/lucide/icons \
#     --sizes 24 --out src/components/icons/hintIcons.h
hint-up = chevron-up
hint-down = chevron-down
hint-left = chevron-left
hint-right = chevron-right
